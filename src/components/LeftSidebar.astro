---
import { CATEGORY_MAP } from '../data/categoryMap';
import { getCollection } from 'astro:content';

interface Props {
  currentSlug?: string;
  currentHash?: string;
}

const { currentSlug = '' } = Astro.props;

const allTerms = await getCollection('terms');
const termTitleMap = new Map<string, string>();
allTerms.forEach((term) => {
  termTitleMap.set(term.id, term.data.title);
});
---

<aside id="left-sidebar" class="w-full lg:w-72 shrink-0 py-2">
  <div class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto pr-2 space-y-4 text-sm font-sans">
    <!-- Overview Link -->
    <a
      href="/"
      id="sidebar-link-overview"
      class={`flex items-center gap-2 px-3 py-2 rounded-lg font-serif font-semibold transition-colors ${
        !currentSlug
          ? 'bg-amber-100 dark:bg-amber-950/80 text-amber-800 dark:text-amber-300 font-bold'
          : 'text-stone-700 dark:text-stone-300 hover:bg-stone-200/60 dark:hover:bg-stone-800'
      }`}
    >
      <svg class="w-4 h-4 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 00-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 00-1 1m-6 0h6" />
      </svg>
      <span>Overview & Index</span>
    </a>

    <div class="border-t border-stone-200 dark:border-stone-800 pt-3">
      <span class="px-3 text-xs font-semibold text-stone-400 dark:text-stone-500 uppercase tracking-wider font-mono">
        Knowledge Base Architecture
      </span>
    </div>

    <!-- 7 Core Parts -->
    <div class="space-y-2">
      {
        CATEGORY_MAP.map((part) => {
          const isPartActive = part.subcategories.some((sub) => sub.termSlugs.includes(currentSlug));

          return (
            <details class="group sidebar-part" open={isPartActive || !currentSlug}>
              <summary class="flex items-center justify-between px-2.5 py-1.5 rounded-lg cursor-pointer font-serif font-medium text-stone-800 dark:text-stone-200 hover:bg-stone-200/50 dark:hover:bg-stone-800/50 transition-colors select-none">
                <span class="line-clamp-1">{part.title}</span>
                <svg
                  class="w-4 h-4 text-stone-400 group-open:rotate-90 transition-transform shrink-0 ml-1"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </summary>

              <div class="ml-3 pl-2.5 border-l border-stone-200 dark:border-stone-800 my-1 space-y-1">
                {part.subcategories.map((sub) => {
                  const isSubActive = sub.termSlugs.includes(currentSlug);

                  return (
                    <details class="group/sub sidebar-sub" open={isSubActive} id={`sidebar-sub-${sub.id}`}>
                      <summary class="flex items-center justify-between px-2 py-1 text-xs rounded font-medium text-stone-600 dark:text-stone-400 hover:text-amber-700 dark:hover:text-amber-400 cursor-pointer select-none">
                        <a
                          href={`/#${sub.id}`}
                          class="hover:underline flex-1"
                          data-subcategory-hash={sub.id}
                        >
                          {sub.title}
                        </a>
                        <svg
                          class="w-3 h-3 text-stone-400 group-open/sub:rotate-90 transition-transform shrink-0"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                      </summary>

                      <ul class="ml-2 pl-2 border-l border-stone-200/60 dark:border-stone-800/60 my-1 space-y-0.5 text-xs">
                        {sub.termSlugs.map((slug) => {
                          const isTermActive = slug === currentSlug;
                          const displayTitle = termTitleMap.get(slug) || slug;

                          return (
                            <li>
                              <a
                                href={`/terms/${slug}`}
                                data-term-slug={slug}
                                class={`block px-2 py-1 rounded transition-colors ${
                                  isTermActive
                                    ? 'bg-amber-600 text-stone-50 font-semibold shadow-xs'
                                    : 'text-stone-600 dark:text-stone-400 hover:text-amber-600 dark:hover:text-amber-400 hover:bg-stone-200/40 dark:hover:bg-stone-800/40'
                                }`}
                              >
                                {displayTitle}
                              </a>
                            </li>
                          );
                        })}
                      </ul>
                    </details>
                  );
                })}
              </div>
            </details>
          );
        })
      }
    </div>
  </div>
</aside>
