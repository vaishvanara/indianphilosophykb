---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings?: Heading[];
}

const { headings = [] } = Astro.props;
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<aside id="right-sidebar" class="hidden xl:block w-64 shrink-0 py-2">
  <div class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto pl-4 border-l border-stone-200 dark:border-stone-800 space-y-3 font-sans">
    <div class="flex items-center gap-2 text-xs font-mono text-[var(--text-secondary)] uppercase tracking-wider font-semibold">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
      </svg>
      <span>On This Page</span>
    </div>

    {
      tocHeadings.length === 0 ? (
        <p class="text-[var(--text-secondary)] italic">
          No headings on this page
        </p>
      ) : (
        <ul id="toc-list" class="space-y-1.5">
          {tocHeadings.map((h) => (
            <li class={h.depth === 3 ? 'ml-3' : ''}>
              <a
                href={`#${h.slug}`}
                data-toc-slug={h.slug}
                aria-current="false"
                class="toc-link block text-sm leading-5 text-[var(--text-primary)] hover:text-amber-600 dark:hover:text-amber-400 transition-colors rounded-r-md pr-2"
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</aside>

<script>
  let cleanupTocHighlight = () => {};

  function setupTocHighlight() {
    cleanupTocHighlight();

    const tocLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('.toc-link')
    );

    if (tocLinks.length === 0) return;

    const headingElements = tocLinks
      .map((link) => {
        const slug = link.dataset.tocSlug;
        return slug ? document.getElementById(slug) : null;
      })
      .filter((heading): heading is HTMLElement => heading !== null);

    if (headingElements.length === 0) return;

    const setActive = (activeId: string) => {
      tocLinks.forEach((link) => {
        const isActive = link.dataset.tocSlug === activeId;

        link.classList.toggle('is-active', isActive);
        link.setAttribute('aria-current', isActive ? 'location' : 'false');
      });
    };

    const updateActiveHeading = () => {
      // Account for the sticky header and keep the "active zone"
      // near the top of the article viewport.
      const activationOffset = 120;

      let activeId = '';

      for (const heading of headingElements) {
        if (heading.getBoundingClientRect().top <= activationOffset) {
          activeId = heading.id;
        } else {
          break;
        }
      }

      setActive(activeId);
    };

    let ticking = false;

    const handleScroll = () => {
      if (ticking) return;

      ticking = true;

      requestAnimationFrame(() => {
        updateActiveHeading();
        ticking = false;
      });
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    window.addEventListener('resize', handleScroll);

    updateActiveHeading();

    cleanupTocHighlight = () => {
      window.removeEventListener('scroll', handleScroll);
      window.removeEventListener('resize', handleScroll);
      cleanupTocHighlight = () => {};
    };
  }

  setupTocHighlight();
  document.addEventListener('astro:after-swap', setupTocHighlight);
</script>
