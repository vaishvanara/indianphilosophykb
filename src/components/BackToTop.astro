---
---

<button
  id="back-to-top"
  type="button"
  class="fixed bottom-6 right-6 z-40 p-3 rounded-full bg-amber-600 text-stone-50 shadow-lg hover:bg-amber-700 transition-all duration-200 opacity-0 pointer-events-none translate-y-4 focus:outline-none focus:ring-2 focus:ring-amber-500"
  aria-label="Back to top"
>
  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18" />
  </svg>
</button>

<script>
  function setupBackToTop() {
    const btn = document.getElementById('back-to-top');
    if (!btn) return;

    window.addEventListener('scroll', () => {
      if (window.scrollY > 300) {
        btn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
        btn.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
      } else {
        btn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
        btn.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
      }
    });

    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  setupBackToTop();
  document.addEventListener('astro:after-swap', setupBackToTop);
</script>
