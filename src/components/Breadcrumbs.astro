---
interface Props {
  partTitle?: string;
  subCategoryTitle?: string;
  termTitle?: string;
}

const { partTitle, subCategoryTitle, termTitle } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// Utility function to generate URL slug matching standard Astro/Markdown heading IDs
function slugify(text: string): string {
  return text
    .toLowerCase()
    .trim()
    .replace(/[^\w\s-]/g, '')
    .replace(/[\s_-]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

const partHref = partTitle ? `${baseUrl}/#${slugify(partTitle)}` : null;
const subCategoryHref = subCategoryTitle ? `${baseUrl}/#${slugify(subCategoryTitle)}` : null;
---

<nav
  aria-label="Breadcrumb"
  class="min-w-0 mb-4 py-1 text-xs text-stone-500 dark:text-stone-400 font-sans"
>
  <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1 min-w-0">
    <li class="shrink-0">
      <a
        href={baseUrl || '/'}
        class="hover:text-amber-600 dark:hover:text-amber-400 transition-colors flex items-center gap-1 font-serif"
      >
        <span>Home</span>
      </a>
    </li>

    {
      partTitle && partHref && (
        <>
          <li class="text-stone-300 dark:text-stone-600 shrink-0">/</li>
          <li class="break-words whitespace-normal">
            <a
              href={partHref}
              class="hover:text-amber-600 dark:hover:text-amber-400 transition-colors"
            >
              {partTitle}
            </a>
          </li>
        </>
      )
    }

    {
      subCategoryTitle && subCategoryHref && (
        <>
          <li class="text-stone-300 dark:text-stone-600 shrink-0">/</li>
          <li class="break-words whitespace-normal">
            <a
              href={subCategoryHref}
              class="hover:text-amber-600 dark:hover:text-amber-400 transition-colors"
            >
              {subCategoryTitle}
            </a>
          </li>
        </>
      )
    }

    {
      termTitle && (
        <>
          <li class="text-stone-300 dark:text-stone-600 shrink-0">/</li>
          <li class="font-semibold text-amber-700 dark:text-amber-400 font-serif break-words whitespace-normal">
            {termTitle}
          </li>
        </>
      )
    }
  </ol>
</nav>