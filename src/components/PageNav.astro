---
import { getAllOrderedSlugs } from '../data/categoryMap';
import { getCollection } from 'astro:content';

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;

const allSlugs = getAllOrderedSlugs();
const currentIndex = allSlugs.indexOf(currentSlug);

const prevSlug = currentIndex > 0 ? allSlugs[currentIndex - 1] : null;
const nextSlug = currentIndex >= 0 && currentIndex < allSlugs.length - 1 ? allSlugs[currentIndex + 1] : null;

const allTerms = await getCollection('terms');
const termMap = new Map<string, string>();
allTerms.forEach((t) => termMap.set(t.id, t.data.title));

const prevTitle = prevSlug ? termMap.get(prevSlug) || prevSlug : null;
const nextTitle = nextSlug ? termMap.get(nextSlug) || nextSlug : null;
---

<nav aria-label="Sequential Page Navigation" class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-12 pt-6 border-t border-stone-200 dark:border-stone-800">
  {
    prevSlug ? (
      <a
        href={`/terms/${prevSlug}`}
        class="flex flex-col p-4 rounded-xl border border-stone-200 dark:border-stone-800 hover:border-amber-500/60 bg-stone-100/50 dark:bg-stone-900/50 hover:bg-stone-200/50 dark:hover:bg-stone-800/50 transition-colors group"
      >
        <span class="text-xs text-stone-500 dark:text-stone-400 font-mono mb-1">← Previous Term</span>
        <span class="font-serif font-bold text-stone-800 dark:text-stone-200 group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors">
          {prevTitle}
        </span>
      </a>
    ) : (
      <div />
    )
  }

  {
    nextSlug ? (
      <a
        href={`/terms/${nextSlug}`}
        class="flex flex-col items-end text-right p-4 rounded-xl border border-stone-200 dark:border-stone-800 hover:border-amber-500/60 bg-stone-100/50 dark:bg-stone-900/50 hover:bg-stone-200/50 dark:hover:bg-stone-800/50 transition-colors group sm:col-start-2"
      >
        <span class="text-xs text-stone-500 dark:text-stone-400 font-mono mb-1">Next Term →</span>
        <span class="font-serif font-bold text-stone-800 dark:text-stone-200 group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors">
          {nextTitle}
        </span>
      </a>
    ) : (
      <div />
    )
  }
</nav>
