---
import BaseLayout from './BaseLayout.astro';
import LeftSidebar from '../components/LeftSidebar.astro';
import RightSidebar from '../components/RightSidebar.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageNav from '../components/PageNav.astro';
import BackToTop from '../components/BackToTop.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  devanagari?: string;
  iast?: string;
  lastUpdated?: Date | string;
  headings?: Heading[];
  partTitle?: string;
  subCategoryTitle?: string;
  slug: string;
}

const { title, devanagari, iast, lastUpdated, headings = [], partTitle, subCategoryTitle, slug } = Astro.props;

const formattedDate = lastUpdated
  ? new Date(lastUpdated).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    })
  : 'Oct 5, 2026';
---

<BaseLayout title={`${title} - Indian Philosophy KB`} description={`Definition, etymology, and philosophical analysis of ${title} in Indian Philosophy.`}>
  <div class="flex flex-col lg:flex-row gap-8">
    <!-- Left Sidebar -->
    <LeftSidebar currentSlug={slug} />

    <!-- Main Article Column -->
    <main class="flex-[1_1_750px] max-w-[750px] min-w-0 py-2">
      <Breadcrumbs partTitle={partTitle} subCategoryTitle={subCategoryTitle} termTitle={title} />

      <article class="prose max-w-none">
        <header class="mb-6 pb-4 border-b border-stone-200 dark:border-stone-800">
          <h1 class="text-3xl sm:text-4xl font-serif font-bold text-stone-900 dark:text-stone-100 tracking-tight mb-2">
            {title}
          </h1>

          <div class="flex flex-wrap items-center gap-4 text-xs text-stone-500 dark:text-stone-400 font-sans">
            {
              devanagari && (
                <span class="px-2 py-0.5 rounded bg-amber-100 dark:bg-amber-950/80 text-amber-900 dark:text-amber-300 font-serif font-semibold text-sm">
                  {devanagari}
                </span>
              )
            }
            {iast && <span class="italic font-serif">{iast}</span>}
            <span class="text-stone-300 dark:text-stone-700">•</span>
            <span>Last updated: {formattedDate}</span>
          </div>
        </header>

        <!-- Article Markdown Content -->
        <div class="term-content">
          <slot />
        </div>
      </article>

      <!-- Sequential Prev/Next Navigation -->
      <PageNav currentSlug={slug} />
    </main>

    <!-- Right TOC Sidebar -->
    <RightSidebar headings={headings} />
  </div>

  <BackToTop />
</BaseLayout>