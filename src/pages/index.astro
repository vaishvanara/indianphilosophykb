---
import HomeLayout from '../layouts/HomeLayout.astro';
// Direct Markdown import — bypasses content collection loaders completely
import { Content } from '../content/kb/indianphilosophykb.md';
---

<HomeLayout
  title="Indian Philosophy Knowledge Base - Overview & Index"
  description="Master index and classical philosophical architecture of Indian Philosophy, covering Epistemology, Ontology, Cosmology, Psychology, Embodiment, Practical Discipline, and Traditions."
>
  <div class="prose max-w-none dark:prose-invert">
    <div id="homepage-content" class="space-y-6">
      <Content />
    </div>
  </div>
</HomeLayout>

<script>
  function setupBiDirectionalSync() {
    const sidebarSubLinks = document.querySelectorAll<HTMLAnchorElement>('[data-subcategory-hash]');

    function handleHashChange() {
      const hash = window.location.hash.replace('#', '');
      if (!hash) return;

      const targetEl = document.getElementById(hash);
      if (targetEl) {
        let current: HTMLElement | null = targetEl;
        while (current) {
          if (current.tagName === 'DETAILS') {
            (current as HTMLDetailsElement).open = true;
          }
          current = current.parentElement;
        }

        targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        highlightSidebarLink(hash);
      }
    }

    function highlightSidebarLink(hash: string) {
      sidebarSubLinks.forEach((link) => {
        const linkHash = link.getAttribute('data-subcategory-hash');
        if (linkHash === hash) {
          link.classList.add('text-amber-600', 'dark:text-amber-400', 'font-bold', 'underline');
          let p: HTMLElement | null = link.parentElement;
          while (p) {
            if (p.tagName === 'DETAILS') {
              (p as HTMLDetailsElement).open = true;
            }
            p = p.parentElement;
          }
        } else {
          link.classList.remove('text-amber-600', 'dark:text-amber-400', 'font-bold', 'underline');
        }
      });
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && entry.target.id) {
            highlightSidebarLink(entry.target.id);
          }
        });
      },
      { rootMargin: '-100px 0px -60% 0px' }
    );

    document.querySelectorAll<HTMLElement>('h2[id], h3[id], section[id], details[id]').forEach((el) => {
      observer.observe(el);
    });

    window.addEventListener('hashchange', handleHashChange);
    if (window.location.hash) {
      setTimeout(handleHashChange, 100);
    }
  }

  setupBiDirectionalSync();
  document.addEventListener('astro:after-swap', setupBiDirectionalSync);
</script>